D_SOURCE("platform/storage/d_storage.c")
D_SOURCE("platform/screen/power/d_screen_power.c")
D_SOURCE("platform/pwm/d_pwm.c")
D_SOURCE("platform/screen/lcd/d_lcd_compat.c")

#ifdef D_TCP_CLIENT_TEST
