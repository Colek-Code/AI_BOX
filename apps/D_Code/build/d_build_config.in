/*
 * Preprocessor input for the internal Make configuration cache.
 * The generated file lives under objs/ and is never edited or committed.
 */
#define D_CONFIG_RESOLVE_ONLY 1
#include "app_config.h"

D_BUILD_D_CODE_SOURCES :=
#define D_SOURCE(path) D_BUILD_D_CODE_SOURCES += path
#include "d_firmware_sources.def"
#undef D_SOURCE

D_BUILD_BOARD_TARGET := D_BOARD_TARGET
D_BUILD_UI_TARGET := D_UI_TARGET

#if D_BOARD_TARGET == D_BOARD_COPY_GC9307_HYN
D_BUILD_BOARD_GC9307 := 1
D_BUILD_BOARD_EMI_ILI948X := 0
#else
D_BUILD_BOARD_GC9307 := 0
D_BUILD_BOARD_EMI_ILI948X := 1
#endif

#if D_UI_TARGET == D_UI_PRODUCT
D_BUILD_UI_PRODUCT := 1
#else
D_BUILD_UI_PRODUCT := 0
#endif
#if D_UI_TARGET == D_UI_TABLET_SHELL
D_BUILD_UI_TABLET_SHELL := 1
#else
D_BUILD_UI_TABLET_SHELL := 0
#endif
#if D_UI_TARGET == D_UI_SCREEN_TEST
D_BUILD_UI_SCREEN_TEST := 1
#else
D_BUILD_UI_SCREEN_TEST := 0
#endif
#if D_UI_TARGET == D_UI_CIPHER_PANEL
D_BUILD_UI_CIPHER_PANEL := 1
#else
D_BUILD_UI_CIPHER_PANEL := 0
#endif
#if D_UI_TARGET == D_UI_LAUNCHER_DEMO
D_BUILD_UI_LAUNCHER_DEMO := 1
#else
D_BUILD_UI_LAUNCHER_DEMO := 0
#endif
#if D_UI_TARGET == D_UI_LIGHT_SPOT_DEMO
D_BUILD_UI_LIGHT_SPOT_DEMO := 1
#else
D_BUILD_UI_LIGHT_SPOT_DEMO := 0
#endif

D_BUILD_FEATURE_WIFI := D_FEATURE_WIFI
D_BUILD_FEATURE_KEY_SERVICE := D_FEATURE_KEY_SERVICE
D_BUILD_FEATURE_POWER_CONTROL := D_FEATURE_POWER_CONTROL
D_BUILD_FEATURE_BLE_PROVISION := D_FEATURE_BLE_PROVISION
D_BUILD_FEATURE_WEBSOCKET := D_DEVICE_CLOUD_ENABLE
#if D_FEATURE_QWEN
#if D_QWEN_AUTH_MODE == D_QWEN_AUTH_MODE_FULL_MANAGED
D_BUILD_QWEN_AUTH_MODE := 1
#else
D_BUILD_QWEN_AUTH_MODE := 2
#endif
#else
D_BUILD_QWEN_AUTH_MODE := 0
#endif
D_BUILD_FEATURE_AI_CHAT := D_FEATURE_AI_CHAT
D_BUILD_FEATURE_CAMERA := D_FEATURE_CAMERA
D_BUILD_CAMERA_PREVIEW := D_CAMERA_PREVIEW_ENABLE
D_BUILD_FEATURE_GALLERY := D_FEATURE_GALLERY
D_BUILD_FEATURE_LOCAL_MUSIC := D_FEATURE_LOCAL_MUSIC
D_BUILD_FEATURE_QWEN := D_FEATURE_QWEN
D_BUILD_FEATURE_XIAOLE_WAKEUP := D_FEATURE_XIAOLE_WAKEUP
D_BUILD_FEATURE_BRTC := D_FEATURE_BRTC
D_BUILD_FEATURE_RTC_AUDIO := D_FEATURE_RTC_AUDIO
D_BUILD_FEATURE_OTA := D_FEATURE_OTA
D_BUILD_DEBUG_VISUAL_CAPTURE := D_DEBUG_VISUAL_CAPTURE
D_BUILD_DOUBLE_BANK := D_OTA_DOUBLE_BANK
D_BUILD_OTA_KEEP_VM := D_OTA_KEEP_VM
D_BUILD_OTA_BOOT_VERSION := D_OTA_BOOT_VERSION
D_BUILD_FIRMWARE_VERSION := D_FIRMWARE_VERSION

#if D_FEATURE_QWEN || D_FEATURE_XIAOLE_WAKEUP || D_FEATURE_BRTC || \
    D_FEATURE_RTC_AUDIO || D_FEATURE_LOCAL_MUSIC || D_LOCAL_PROMPT_ENABLE
D_BUILD_AUDIO := 1
#else
D_BUILD_AUDIO := 0
#endif
