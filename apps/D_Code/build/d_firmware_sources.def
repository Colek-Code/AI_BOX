/*
 * D_Code firmware source list.
 *
 * This file deliberately has no include guard: the build resolver includes it
 * after defining D_SOURCE().  Adding an ordinary D_Code module therefore needs
 * only one C-style entry here; the Makefile remains an internal implementation.
 */
#ifndef D_SOURCE
#error "d_firmware_sources.def 只能由内部构建解析器包含"
#endif

/* Application skeleton and framework. */
D_SOURCE("app/app_main.c")
D_SOURCE("app/d_service_startup.c")
D_SOURCE("app/d_ui_startup.c")
D_SOURCE("config/d_config_report.c")
D_SOURCE("board/wl82/d_board.c")
D_SOURCE("framework/d_lvgl.c")
D_SOURCE("framework/d_ui_font.c")
